# ShelfSense backend configuration. Copy to `.env` only if you need to change
# something; with every value blank the app runs fully on local mocks.

# development | production. Production requires SUPABASE_JWT_SECRET, disables
# demo auth and test-mode plan switching, and stops serving /media publicly.
APP_ENV=development

# Blank = each integration is real when its key is set. `true` forces every
# integration (TinyFish, Gemini, storage) into mock mode even with keys present.
MOCK_MODE=

# Blank = SQLite at ./shelfsense.db. Postgres: postgresql+asyncpg://user:pass@host:5432/db
# Alembic migrations use this same async URL.
DATABASE_URL=

# TinyFish web agents. With a key (and MOCK_MODE not true) checks run live;
# otherwise the simulated agent is used. AGENT_BASE_URL is required when live.
TINYFISH_API_KEY=
TINYFISH_AGENT_BASE_URL=
TINYFISH_SEARCH_BASE_URL=
TINYFISH_FETCH_BASE_URL=
# Agent sessions running at once across the whole process.
TINYFISH_MAX_CONCURRENCY=2
# Per agent-run HTTP timeout in seconds (browser sessions are slow).
TINYFISH_AGENT_TIMEOUT_SECONDS=120

# Google Gemini for summaries, recommendations, chat and rule parsing.
# Blank = rule-based fallback with the same response shapes.
GEMINI_API_KEY=
GEMINI_MODEL=

# Telegram bot. Blank token = bot not started, messages are logged instead.
# The username (without @) enables t.me deep links on link codes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Supabase. URL + service key switch screenshot storage to Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Verifies user access tokens (HS256). Blank in development = demo auth: every
# request is the seeded demo user. Required in production.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=screenshots

# Frontend origin for CORS and links in Telegram messages. Development also
# allows any localhost / 127.0.0.1 port.
FRONTEND_ORIGIN=http://localhost:3000
