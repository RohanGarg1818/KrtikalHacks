# Backend base URL (no trailing slash). Screenshots and SSE streams are served from here too.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Supabase auth. Set BOTH to require login (email + password or magic link at /login);
# the session token is sent as `Authorization: Bearer` on every API call and as `access_token`
# on run streams. Leave blank for demo mode (no login; the backend's dev account is used).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional support address shown in the Help centre (falls back to a demo placeholder).
NEXT_PUBLIC_SUPPORT_EMAIL=
